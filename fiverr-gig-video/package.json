{
  "name": "fiverr-gig-video",
  "version": "1.0.0",
  "private": true,
  "description": "Fiverr gig cover motion video for a Mobile App Developer, built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render GigVideo out/gig-video.mp4 --codec=h264 --crf=16",
    "still": "remotion still GigCover out/gig-cover.png",
    "build": "npm run render && npm run still"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.529",
    "typescript": "^5.9.3"
  }
}
